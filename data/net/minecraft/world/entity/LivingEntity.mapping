CLASS net/minecraft/world/entity/LivingEntity
	METHOD die (Lnet/minecraft/world/damagesource/DamageSource;)V
		ARG 1 source
	METHOD drop (Lnet/minecraft/world/item/ItemStack;ZZ)Lnet/minecraft/world/entity/item/ItemEntity;
		ARG 1 itemStack
		ARG 2 randomly
		ARG 3 thrownFromHand
	METHOD handleExtraItemsCreatedOnUse (Lnet/minecraft/world/item/ItemStack;)V
		ARG 1 extraCreatedRemainder
	METHOD indicateDamage (DD)V
		ARG 1 xd
		ARG 3 zd
	METHOD isInvulnerableTo (Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/world/damagesource/DamageSource;)Z
		ARG 1 level
		ARG 2 source
	METHOD onAttributeUpdated (Lnet/minecraft/core/Holder;)V
		ARG 1 attribute
	METHOD onChangedBlock (Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/core/BlockPos;)V
		ARG 1 level
		ARG 2 pos
	METHOD onEffectAdded (Lnet/minecraft/world/effect/MobEffectInstance;Lnet/minecraft/world/entity/Entity;)V
		ARG 1 effect
		ARG 2 source
	METHOD onEffectsRemoved (Ljava/util/Collection;)V
		ARG 1 effects
	METHOD onEffectUpdated (Lnet/minecraft/world/effect/MobEffectInstance;ZLnet/minecraft/world/entity/Entity;)V
		ARG 1 effect
		ARG 2 doRefreshAttributes
		ARG 3 source
	METHOD onEquippedItemBroken (Lnet/minecraft/world/item/Item;Lnet/minecraft/world/entity/EquipmentSlot;)V
		ARG 1 brokenItem
		ARG 2 inSlot
	METHOD onItemPickup (Lnet/minecraft/world/entity/item/ItemEntity;)V
		ARG 1 entity
	METHOD startSleeping (Lnet/minecraft/core/BlockPos;)V
		ARG 1 bedPosition
	METHOD swing (Lnet/minecraft/world/InteractionHand;)V
		ARG 1 hand
	METHOD take (Lnet/minecraft/world/entity/Entity;I)V
		ARG 1 entity
		ARG 2 orgCount
	METHOD updateUsingItem (Lnet/minecraft/world/item/ItemStack;)V
		ARG 1 useItem
