CLASS net/minecraft/world/entity/ai/behavior/ChargeAttack
	METHOD <init> (ILnet/minecraft/world/entity/ai/targeting/TargetingConditions;FFDDLnet/minecraft/sounds/SoundEvent;)V
		ARG 1 timeBetweenAttacks
		ARG 2 chargeTargeting
		ARG 3 speed
		ARG 4 knockbackForce
		ARG 5 maxChargeDistance
		ARG 7 maxTargetDetectionDistance
		ARG 9 chargeSound
	METHOD dealDamageToTarget (Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/world/entity/animal/Animal;Lnet/minecraft/world/entity/LivingEntity;)V
		ARG 1 level
		ARG 2 body
		ARG 3 target
	METHOD dealKnockBack (Lnet/minecraft/world/entity/animal/Animal;Lnet/minecraft/world/entity/LivingEntity;)V
		ARG 1 body
		ARG 2 target
	METHOD lambda$tick$0 (Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/world/entity/animal/Animal;Lnet/minecraft/world/entity/LivingEntity;)Z
		ARG 3 e
