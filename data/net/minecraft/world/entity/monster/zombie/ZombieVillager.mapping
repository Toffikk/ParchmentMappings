CLASS net/minecraft/world/entity/monster/zombie/ZombieVillager
	METHOD finishConversion (Lnet/minecraft/server/level/ServerLevel;)V
		ARG 1 level
	METHOD lambda$finishConversion$0 (Lnet/minecraft/world/item/ItemStack;)Z
		ARG 0 stack
	METHOD lambda$finishConversion$1 (Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/world/entity/npc/villager/Villager;)V
		ARG 2 villager
	METHOD setGossips (Lnet/minecraft/world/entity/ai/gossip/GossipContainer;)V
		ARG 1 gossips
	METHOD setTradeOffers (Lnet/minecraft/world/item/trading/MerchantOffers;)V
		ARG 1 tradeOffers
	METHOD setVillagerConversionTime (I)V
		ARG 1 conversionTime
	METHOD setVillagerXp (I)V
		ARG 1 villagerXp
	METHOD startConverting (Ljava/util/UUID;I)V
		ARG 1 player
		ARG 2 time
