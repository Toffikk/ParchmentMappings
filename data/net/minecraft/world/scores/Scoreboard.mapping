CLASS net/minecraft/world/scores/Scoreboard
	METHOD addPlayerToTeam (Ljava/lang/String;Lnet/minecraft/world/scores/PlayerTeam;)Z
		ARG 1 player
		ARG 2 team
	METHOD onObjectiveAdded (Lnet/minecraft/world/scores/Objective;)V
		ARG 1 objective
	METHOD onObjectiveChanged (Lnet/minecraft/world/scores/Objective;)V
		ARG 1 objective
	METHOD onObjectiveRemoved (Lnet/minecraft/world/scores/Objective;)V
		ARG 1 objective
	METHOD onPlayerRemoved (Lnet/minecraft/world/scores/ScoreHolder;)V
		ARG 1 player
	METHOD onPlayerScoreRemoved (Lnet/minecraft/world/scores/ScoreHolder;Lnet/minecraft/world/scores/Objective;)V
		ARG 1 player
		ARG 2 objective
	METHOD onScoreChanged (Lnet/minecraft/world/scores/ScoreHolder;Lnet/minecraft/world/scores/Objective;Lnet/minecraft/world/scores/Score;)V
		ARG 1 owner
		ARG 2 objective
		ARG 3 score
	METHOD onScoreLockChanged (Lnet/minecraft/world/scores/ScoreHolder;Lnet/minecraft/world/scores/Objective;)V
		ARG 1 owner
		ARG 2 objective
	METHOD onTeamAdded (Lnet/minecraft/world/scores/PlayerTeam;)V
		ARG 1 team
	METHOD onTeamChanged (Lnet/minecraft/world/scores/PlayerTeam;)V
		ARG 1 team
	METHOD onTeamRemoved (Lnet/minecraft/world/scores/PlayerTeam;)V
		ARG 1 team
	METHOD removePlayerFromTeam (Ljava/lang/String;Lnet/minecraft/world/scores/PlayerTeam;)V
		ARG 1 player
		ARG 2 team
	METHOD setDisplayObjective (Lnet/minecraft/world/scores/DisplaySlot;Lnet/minecraft/world/scores/Objective;)V
		ARG 1 slot
		ARG 2 objective
