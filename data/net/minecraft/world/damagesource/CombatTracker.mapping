CLASS net/minecraft/world/damagesource/CombatTracker
	METHOD <init> (Lnet/minecraft/world/entity/LivingEntity;)V
		ARG 1 mob
	METHOD getDisplayName (Lnet/minecraft/world/entity/Entity;)Lnet/minecraft/network/chat/Component;
		ARG 0 entity
	METHOD getFallMessage (Lnet/minecraft/world/damagesource/CombatEntry;Lnet/minecraft/world/entity/Entity;)Lnet/minecraft/network/chat/Component;
		ARG 1 knockOffEntry
		ARG 2 killingEntity
	METHOD getMessageForAssistedFall (Lnet/minecraft/world/entity/Entity;Lnet/minecraft/network/chat/Component;Ljava/lang/String;Ljava/lang/String;)Lnet/minecraft/network/chat/Component;
		ARG 1 attackerEntity
		ARG 2 attackerName
		ARG 3 messageWithItem
		ARG 4 messageWithoutItem
	METHOD recordDamage (Lnet/minecraft/world/damagesource/DamageSource;F)V
		ARG 1 source
		ARG 2 damage
	METHOD shouldEnterCombat (Lnet/minecraft/world/damagesource/DamageSource;)Z
		ARG 0 source
