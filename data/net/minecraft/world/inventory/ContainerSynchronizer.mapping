CLASS net/minecraft/world/inventory/ContainerSynchronizer
	METHOD sendCarriedChange (Lnet/minecraft/world/inventory/AbstractContainerMenu;Lnet/minecraft/world/item/ItemStack;)V
		ARG 1 container
		ARG 2 itemStack
	METHOD sendDataChange (Lnet/minecraft/world/inventory/AbstractContainerMenu;II)V
		ARG 1 container
		ARG 2 id
		ARG 3 value
	METHOD sendInitialData (Lnet/minecraft/world/inventory/AbstractContainerMenu;Ljava/util/List;Lnet/minecraft/world/item/ItemStack;[I)V
		ARG 1 container
		ARG 2 slotItems
		ARG 3 carried
		ARG 4 dataSlots
	METHOD sendSlotChange (Lnet/minecraft/world/inventory/AbstractContainerMenu;ILnet/minecraft/world/item/ItemStack;)V
		ARG 1 container
		ARG 2 slotIndex
		ARG 3 itemStack
