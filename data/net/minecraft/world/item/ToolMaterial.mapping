CLASS net/minecraft/world/item/ToolMaterial
	METHOD applyCommonProperties (Lnet/minecraft/world/item/Item$Properties;)Lnet/minecraft/world/item/Item$Properties;
		ARG 1 properties
	METHOD applySwordProperties (Lnet/minecraft/world/item/Item$Properties;FF)Lnet/minecraft/world/item/Item$Properties;
		ARG 1 properties
		ARG 2 attackDamageBaseline
		ARG 3 attackSpeedBaseline
	METHOD applyToolProperties (Lnet/minecraft/world/item/Item$Properties;Lnet/minecraft/tags/TagKey;FFF)Lnet/minecraft/world/item/Item$Properties;
		ARG 1 properties
		ARG 2 minesEfficiently
		ARG 3 attackDamageBaseline
		ARG 4 attackSpeedBaseline
		ARG 5 disableBlockingSeconds
	METHOD createSwordAttributes (FF)Lnet/minecraft/world/item/component/ItemAttributeModifiers;
		ARG 1 attackDamageBaseline
		ARG 2 attackSpeedBaseline
	METHOD createToolAttributes (FF)Lnet/minecraft/world/item/component/ItemAttributeModifiers;
		ARG 1 attackDamageBaseline
		ARG 2 attackSpeedBaseline
