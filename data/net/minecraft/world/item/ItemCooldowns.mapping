CLASS net/minecraft/world/item/ItemCooldowns
	METHOD addCooldown (Lnet/minecraft/resources/Identifier;I)V
		ARG 1 cooldownGroup
		ARG 2 time
	METHOD addCooldown (Lnet/minecraft/world/item/ItemStack;I)V
		ARG 1 item
		ARG 2 time
	METHOD getCooldownGroup (Lnet/minecraft/world/item/ItemStack;)Lnet/minecraft/resources/Identifier;
		ARG 1 item
	METHOD getCooldownPercent (Lnet/minecraft/world/item/ItemStack;F)F
		ARG 1 item
		ARG 2 a
	METHOD isOnCooldown (Lnet/minecraft/world/item/ItemStack;)Z
		ARG 1 item
	METHOD onCooldownEnded (Lnet/minecraft/resources/Identifier;)V
		ARG 1 cooldownGroup
	METHOD onCooldownStarted (Lnet/minecraft/resources/Identifier;I)V
		ARG 1 cooldownGroup
		ARG 2 duration
	METHOD removeCooldown (Lnet/minecraft/resources/Identifier;)V
		ARG 1 cooldownGroup
