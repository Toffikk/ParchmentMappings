CLASS net/minecraft/world/food/FoodData
	METHOD add (IF)V
		ARG 1 food
		ARG 2 saturation
	METHOD addAdditionalSaveData (Lnet/minecraft/world/level/storage/ValueOutput;)V
		ARG 1 output
	METHOD addExhaustion (F)V
		ARG 1 amount
	METHOD eat (IF)V
		ARG 1 food
		ARG 2 saturationModifier
	METHOD eat (Lnet/minecraft/world/food/FoodProperties;)V
		ARG 1 foodProperties
	METHOD readAdditionalSaveData (Lnet/minecraft/world/level/storage/ValueInput;)V
		ARG 1 input
	METHOD setFoodLevel (I)V
		ARG 1 food
	METHOD setSaturation (F)V
		ARG 1 saturation
	METHOD tick (Lnet/minecraft/server/level/ServerPlayer;)V
		ARG 1 player
