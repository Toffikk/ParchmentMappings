CLASS net/minecraft/client/tutorial/Tutorial
	METHOD <init> (Lnet/minecraft/client/Minecraft;Lnet/minecraft/client/Options;)V
		ARG 1 minecraft
		ARG 2 options
	METHOD key (Ljava/lang/String;)Lnet/minecraft/network/chat/Component;
		ARG 0 name
	METHOD onDestroyBlock (Lnet/minecraft/client/multiplayer/ClientLevel;Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/level/block/state/BlockState;F)V
		ARG 1 level
		ARG 2 pos
		ARG 3 state
		ARG 4 percent
	METHOD onGetItem (Lnet/minecraft/world/item/ItemStack;)V
		ARG 1 itemStack
	METHOD onInput (Lnet/minecraft/client/player/ClientInput;)V
		ARG 1 input
	METHOD onInventoryAction (Lnet/minecraft/world/item/ItemStack;Lnet/minecraft/world/item/ItemStack;Lnet/minecraft/world/inventory/ClickAction;)V
		ARG 1 itemCarried
		ARG 2 itemInSlot
		ARG 3 clickAction
	METHOD onLookAt (Lnet/minecraft/client/multiplayer/ClientLevel;Lnet/minecraft/world/phys/HitResult;)V
		ARG 1 level
		ARG 2 hit
	METHOD onMouse (DD)V
		ARG 1 xd
		ARG 3 yd
	METHOD setStep (Lnet/minecraft/client/tutorial/TutorialSteps;)V
		ARG 1 step
