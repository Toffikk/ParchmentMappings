CLASS net/minecraft/client/sounds/SoundManager
	METHOD <init> (Lnet/minecraft/client/Options;)V
		ARG 1 options
	METHOD addListener (Lnet/minecraft/client/sounds/SoundEventListener;)V
		ARG 1 listener
	METHOD getSoundEvent (Lnet/minecraft/resources/Identifier;)Lnet/minecraft/client/sounds/WeighedSoundEvents;
		ARG 1 location
	METHOD isActive (Lnet/minecraft/client/resources/sounds/SoundInstance;)Z
		ARG 1 instance
	METHOD pauseAllExcept ([Lnet/minecraft/sounds/SoundSource;)V
		ARG 1 ignoredSources
	METHOD play (Lnet/minecraft/client/resources/sounds/SoundInstance;)Lnet/minecraft/client/sounds/SoundEngine$PlayResult;
		ARG 1 instance
	METHOD playDelayed (Lnet/minecraft/client/resources/sounds/SoundInstance;I)V
		ARG 1 instance
		ARG 2 delay
	METHOD queueTickingSound (Lnet/minecraft/client/resources/sounds/TickableSoundInstance;)V
		ARG 1 instance
	METHOD refreshCategoryVolume (Lnet/minecraft/sounds/SoundSource;)V
		ARG 1 category
	METHOD removeListener (Lnet/minecraft/client/sounds/SoundEventListener;)V
		ARG 1 listener
	METHOD stop (Lnet/minecraft/client/resources/sounds/SoundInstance;)V
		ARG 1 soundInstance
	METHOD stop (Lnet/minecraft/resources/Identifier;Lnet/minecraft/sounds/SoundSource;)V
		ARG 1 sound
		ARG 2 source
	METHOD tick (Z)V
		ARG 1 paused
	METHOD updateCategoryVolume (Lnet/minecraft/sounds/SoundSource;F)V
		ARG 1 source
		ARG 2 gain
	METHOD updateSource (Lnet/minecraft/client/Camera;)V
		ARG 1 camera
	METHOD validateSoundResource (Lnet/minecraft/client/resources/sounds/Sound;Lnet/minecraft/resources/Identifier;Lnet/minecraft/server/packs/resources/ResourceProvider;)Z
		ARG 0 sound
		ARG 1 eventLocation
		ARG 2 resourceProvider
	CLASS Preparations
		METHOD apply (Ljava/util/Map;Ljava/util/Map;Lnet/minecraft/client/sounds/SoundEngine;)V
			ARG 1 registry
			ARG 2 soundCache
			ARG 3 engine
		METHOD handleRegistration (Lnet/minecraft/resources/Identifier;Lnet/minecraft/client/resources/sounds/SoundEventRegistration;)V
			ARG 1 eventLocation
			ARG 2 soundEventRegistration
		METHOD listResources (Lnet/minecraft/server/packs/resources/ResourceManager;)V
			ARG 1 resourceManager
