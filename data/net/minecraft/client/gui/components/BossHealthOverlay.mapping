CLASS net/minecraft/client/gui/components/BossHealthOverlay
	METHOD <init> (Lnet/minecraft/client/Minecraft;)V
		ARG 1 minecraft
	METHOD drawBar (Lnet/minecraft/client/gui/GuiGraphics;IILnet/minecraft/world/BossEvent;)V
		ARG 1 graphics
		ARG 2 x
		ARG 3 y
		ARG 4 event
	METHOD drawBar (Lnet/minecraft/client/gui/GuiGraphics;IILnet/minecraft/world/BossEvent;I[Lnet/minecraft/resources/Identifier;[Lnet/minecraft/resources/Identifier;)V
		ARG 1 graphics
		ARG 2 x
		ARG 3 y
		ARG 4 event
		ARG 5 width
		ARG 6 sprites
		ARG 7 overlaySprites
	METHOD render (Lnet/minecraft/client/gui/GuiGraphics;)V
		ARG 1 graphics
	METHOD update (Lnet/minecraft/network/protocol/game/ClientboundBossEventPacket;)V
		ARG 1 packet
