CLASS net/minecraft/client/gui/components/spectator/SpectatorGui
	METHOD <init> (Lnet/minecraft/client/Minecraft;)V
		ARG 1 minecraft
	METHOD onHotbarSelected (I)V
		ARG 1 slot
	METHOD onMouseScrolled (I)V
		ARG 1 wheel
	METHOD renderAction (Lnet/minecraft/client/gui/GuiGraphics;)V
		ARG 1 graphics
	METHOD renderHotbar (Lnet/minecraft/client/gui/GuiGraphics;)V
		ARG 1 graphics
	METHOD renderPage (Lnet/minecraft/client/gui/GuiGraphics;FIILnet/minecraft/client/gui/spectator/categories/SpectatorPage;)V
		ARG 1 graphics
		ARG 2 alpha
		ARG 3 screenCenter
		ARG 4 y
		ARG 5 page
	METHOD renderSlot (Lnet/minecraft/client/gui/GuiGraphics;IIFFLnet/minecraft/client/gui/spectator/SpectatorMenuItem;)V
		ARG 1 graphics
		ARG 2 slot
		ARG 3 x
		ARG 4 y
		ARG 5 alpha
		ARG 6 item
