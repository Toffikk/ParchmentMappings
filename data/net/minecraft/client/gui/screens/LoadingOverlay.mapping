CLASS net/minecraft/client/gui/screens/LoadingOverlay
	METHOD <init> (Lnet/minecraft/client/Minecraft;Lnet/minecraft/server/packs/resources/ReloadInstance;Ljava/util/function/Consumer;Z)V
		ARG 1 minecraft
		ARG 2 reload
		ARG 3 onFinish
		ARG 4 fadeIn
	METHOD drawProgressBar (Lnet/minecraft/client/gui/GuiGraphics;IIIIF)V
		ARG 1 graphics
		ARG 2 x0
		ARG 3 y0
		ARG 4 x1
		ARG 5 y1
		ARG 6 fade
	METHOD registerTextures (Lnet/minecraft/client/renderer/texture/TextureManager;)V
		ARG 0 textureManager
	METHOD replaceAlpha (II)I
		ARG 0 color
		ARG 1 alpha
