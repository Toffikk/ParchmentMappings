CLASS net/minecraft/client/gui/screens/inventory/CartographyTableScreen
	METHOD <init> (Lnet/minecraft/world/inventory/CartographyTableMenu;Lnet/minecraft/world/entity/player/Inventory;Lnet/minecraft/network/chat/Component;)V
		ARG 1 menu
		ARG 2 inventory
		ARG 3 title
	METHOD renderMap (Lnet/minecraft/client/gui/GuiGraphics;Lnet/minecraft/world/level/saveddata/maps/MapId;Lnet/minecraft/world/level/saveddata/maps/MapItemSavedData;IIF)V
		ARG 1 graphics
		ARG 2 id
		ARG 3 data
		ARG 4 x
		ARG 5 y
		ARG 6 scale
	METHOD renderResultingMap (Lnet/minecraft/client/gui/GuiGraphics;Lnet/minecraft/world/level/saveddata/maps/MapId;Lnet/minecraft/world/level/saveddata/maps/MapItemSavedData;ZZZZ)V
		ARG 1 graphics
		ARG 2 id
		ARG 3 data
		ARG 4 isDuplication
		ARG 5 isScaling
		ARG 6 isLocking
		ARG 7 locked
