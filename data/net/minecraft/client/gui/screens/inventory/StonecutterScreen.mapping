CLASS net/minecraft/client/gui/screens/inventory/StonecutterScreen
	METHOD <init> (Lnet/minecraft/world/inventory/StonecutterMenu;Lnet/minecraft/world/entity/player/Inventory;Lnet/minecraft/network/chat/Component;)V
		ARG 1 menu
		ARG 2 inventory
		ARG 3 title
	METHOD renderButtons (Lnet/minecraft/client/gui/GuiGraphics;IIIII)V
		ARG 1 graphics
		ARG 2 xm
		ARG 3 ym
		ARG 4 x
		ARG 5 y
		ARG 6 endIndex
	METHOD renderRecipes (Lnet/minecraft/client/gui/GuiGraphics;III)V
		ARG 1 graphics
		ARG 2 x
		ARG 3 y
		ARG 4 endIndex
