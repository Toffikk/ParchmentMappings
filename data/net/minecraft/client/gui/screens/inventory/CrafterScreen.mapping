CLASS net/minecraft/client/gui/screens/inventory/CrafterScreen
	METHOD <init> (Lnet/minecraft/world/inventory/CrafterMenu;Lnet/minecraft/world/entity/player/Inventory;Lnet/minecraft/network/chat/Component;)V
		ARG 1 menu
		ARG 2 inventory
		ARG 3 title
	METHOD disableSlot (I)V
		ARG 1 slotId
	METHOD enableSlot (I)V
