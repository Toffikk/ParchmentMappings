	METHOD getBackwardsInterpolatedWalkDistance (F)F
		ARG 1 partialTicks
	METHOD getInterpolatedBob (F)F
		ARG 1 partialTicks
	METHOD getInterpolatedCloakX (F)D
		ARG 1 partialTicks
	METHOD getInterpolatedCloakY (F)D
		ARG 1 partialTicks
	METHOD getInterpolatedCloakZ (F)D
		ARG 1 partialTicks
	METHOD getInterpolatedWalkDistance (F)F
