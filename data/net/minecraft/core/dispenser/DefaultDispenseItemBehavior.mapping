CLASS net/minecraft/core/dispenser/DefaultDispenseItemBehavior
	METHOD addToInventoryOrDispense (Lnet/minecraft/core/dispenser/BlockSource;Lnet/minecraft/world/item/ItemStack;)V
		ARG 1 source
		ARG 2 itemStack
	METHOD consumeWithRemainder (Lnet/minecraft/core/dispenser/BlockSource;Lnet/minecraft/world/item/ItemStack;Lnet/minecraft/world/item/ItemStack;)Lnet/minecraft/world/item/ItemStack;
		ARG 1 source
		ARG 2 dispensed
		ARG 3 remainder
	METHOD execute (Lnet/minecraft/core/dispenser/BlockSource;Lnet/minecraft/world/item/ItemStack;)Lnet/minecraft/world/item/ItemStack;
		ARG 1 source
		ARG 2 dispensed
	METHOD playAnimation (Lnet/minecraft/core/dispenser/BlockSource;Lnet/minecraft/core/Direction;)V
		ARG 1 source
		ARG 2 direction
	METHOD playDefaultAnimation (Lnet/minecraft/core/dispenser/BlockSource;Lnet/minecraft/core/Direction;)V
		ARG 0 source
		ARG 1 direction
	METHOD playDefaultSound (Lnet/minecraft/core/dispenser/BlockSource;)V
		ARG 0 source
	METHOD playSound (Lnet/minecraft/core/dispenser/BlockSource;)V
		ARG 1 source
	METHOD spawnItem (Lnet/minecraft/world/level/Level;Lnet/minecraft/world/item/ItemStack;ILnet/minecraft/core/Direction;Lnet/minecraft/core/Position;)V
