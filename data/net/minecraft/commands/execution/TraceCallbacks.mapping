CLASS net/minecraft/commands/execution/TraceCallbacks
	METHOD onCall (ILnet/minecraft/resources/Identifier;I)V
		ARG 1 depth
		ARG 2 function
		ARG 3 size
	METHOD onCommand (ILjava/lang/String;)V
		ARG 1 depth
		ARG 2 command
	METHOD onError (Ljava/lang/String;)V
		ARG 1 message
	METHOD onReturn (ILjava/lang/String;I)V
		ARG 1 depth
		ARG 2 command
		ARG 3 result
