CLASS net/minecraft/commands/execution/ExecutionContext
	METHOD <init> (IILnet/minecraft/util/profiling/ProfilerFiller;)V
		ARG 1 commandLimit
		ARG 2 forkLimit
		ARG 3 profiler
	METHOD createTopFrame (Lnet/minecraft/commands/execution/ExecutionContext;Lnet/minecraft/commands/CommandResultCallback;)Lnet/minecraft/commands/execution/Frame;
		ARG 0 context
		ARG 1 frameResult
	METHOD discardAtDepthOrHigher (I)V
		ARG 1 depthToDiscard
	METHOD frameControlForDepth (I)Lnet/minecraft/commands/execution/Frame$FrameControl;
		ARG 1 depthToDiscard
	METHOD queueInitialCommandExecution (Lnet/minecraft/commands/execution/ExecutionContext;Ljava/lang/String;Lcom/mojang/brigadier/context/ContextChain;Lnet/minecraft/commands/ExecutionCommandSource;Lnet/minecraft/commands/CommandResultCallback;)V
		ARG 0 context
		ARG 1 command
		ARG 2 executionChain
		ARG 3 sender
		ARG 4 commandReturn
	METHOD queueInitialFunctionCall (Lnet/minecraft/commands/execution/ExecutionContext;Lnet/minecraft/commands/functions/InstantiatedFunction;Lnet/minecraft/commands/ExecutionCommandSource;Lnet/minecraft/commands/CommandResultCallback;)V
		ARG 0 context
		ARG 1 function
		ARG 2 sender
		ARG 3 functionReturn
	METHOD queueNext (Lnet/minecraft/commands/execution/CommandQueueEntry;)V
		ARG 1 entry
	METHOD tracer (Lnet/minecraft/commands/execution/TraceCallbacks;)V
		ARG 1 tracer
