CLASS net/minecraft/server/network/PlayerChunkSender
	METHOD <init> (Z)V
		ARG 1 memoryConnection
	METHOD collectChunksToSend (Lnet/minecraft/server/level/ChunkMap;Lnet/minecraft/world/level/ChunkPos;)Ljava/util/List;
		ARG 1 chunkMap
		ARG 2 playerPos
