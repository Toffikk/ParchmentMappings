CLASS net/minecraft/network/chat/LastSeenMessagesTracker
	METHOD <init> (I)V
		ARG 1 lastSeenCount
	METHOD addEntry (Lnet/minecraft/network/chat/LastSeenTrackedEntry;)V
		ARG 1 entry
	METHOD addPending (Lnet/minecraft/network/chat/MessageSignature;Z)Z
		ARG 1 message
		ARG 2 wasShown
	METHOD ignorePending (Lnet/minecraft/network/chat/MessageSignature;)V
		ARG 1 pendingMessage
