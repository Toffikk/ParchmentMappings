	METHOD multipliedFill (F)I
		ARG 1 alphaMultiplier
	METHOD multipliedStroke (F)I
		ARG 1 alphaMultiplier
	METHOD stroke (I)Lnet/minecraft/gizmos/GizmoStyle;
		ARG 0 argb
	METHOD stroke (IF)Lnet/minecraft/gizmos/GizmoStyle;
